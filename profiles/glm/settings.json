{
  "env": {
    "ANTHROPIC_BASE_URL": "__HAPY_BASE_URL__",
    "ANTHROPIC_AUTH_TOKEN": "__HAPY_TOKEN__",
    "ANTHROPIC_MODEL": "glm-5.3"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git grep*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude-glm/settings.json)",
      "Read(~/.claude-worker/.credentials.json)",
      "Read(~/.claude-worker/.claude.json)",
      "WebFetch",
      "WebSearch",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git clean*)",
      "Bash(git diff --no-index*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(docker *)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/AGENTS.md)",
      "Write(**/AGENTS.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|NotebookRead|LS",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_CONFIG_DIR/guard-paths.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
